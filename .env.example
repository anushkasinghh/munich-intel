# Copy to .env and edit values. Defaults work out of the box for local dev.
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=munich_intel
EMBEDDING_MODEL=BAAI/bge-m3
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-20b
CHUNK_SIZE=200
CHUNK_OVERLAP=25
# Keep low on Groq's free tier: chunks average ~1150 tokens, and k=5 exceeds the
# 8000 tokens/min limit on a single query.
RETRIEVAL_TOP_K=2
